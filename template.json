{
 "Parameters": {
  "GitHubOwner": {
   "Type": "String",
   "Description": "GitHub account or organization that owns the repository."
  },
  "GitHubOwnerId": {
   "Type": "String",
   "Description": "Immutable numeric GitHub owner ID."
  },
  "GitHubRepository": {
   "Type": "String",
   "Description": "GitHub repository name."
  },
  "GitHubRepositoryId": {
   "Type": "String",
   "Description": "Immutable numeric GitHub repository ID."
  },
  "GitHubCdkDeployWorkflow": {
   "Type": "String",
   "Default": "cdk-deploy",
   "Description": "Workflow allowed to assume the CDK deployment role."
  }
 },
 "Resources": {
  "GitHubOidcProvider": {
   "Type": "AWS::IAM::OIDCProvider",
   "Properties": {
    "ClientIdList": [
     "sts.amazonaws.com"
    ],
    "Url": "https://token.actions.githubusercontent.com"
   },
   "Metadata": {
    "aws:cdk:path": "GitHubOidcStack/GitHubOidcProvider"
   }
  },
  "GitHubCdkDeployRole5F595E0B": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Statement": [
      {
       "Action": "sts:AssumeRoleWithWebIdentity",
       "Condition": {
        "StringEquals": {
         "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
         "token.actions.githubusercontent.com:sub": {
          "Fn::Join": [
           "",
           [
            "repo:",
            {
             "Ref": "GitHubOwner"
            },
            "@",
            {
             "Ref": "GitHubOwnerId"
            },
            "/",
            {
             "Ref": "GitHubRepository"
            },
            "@",
            {
             "Ref": "GitHubRepositoryId"
            },
            ":workflow:",
            {
             "Ref": "GitHubCdkDeployWorkflow"
            },
            ":ref:refs/heads/main"
           ]
          ]
         }
        }
       },
       "Effect": "Allow",
       "Principal": {
        "Federated": {
         "Fn::GetAtt": [
          "GitHubOidcProvider",
          "Arn"
         ]
        }
       }
      }
     ],
     "Version": "2012-10-17"
    },
    "ManagedPolicyArns": [
     {
      "Fn::Join": [
       "",
       [
        "arn:",
        {
         "Ref": "AWS::Partition"
        },
        ":iam::aws:policy/AdministratorAccess"
       ]
      ]
     }
    ],
    "RoleName": "GitHubActionsCdkDeploy"
   },
   "Metadata": {
    "aws:cdk:path": "GitHubOidcStack/GitHubCdkDeployRole/Resource"
   }
  },
  "CDKMetadata": {
   "Type": "AWS::CDK::Metadata",
   "Properties": {
    "Analytics": "v2:deflate64:H4sIAAAAAAAA/yXKTQ6CMBBA4bOwb0csUQ9QN64geAAy0iEZoK3pDywIdzeNq+8tngL1uEFd4R7laBa58geOd8JxEXpyHQa0lCgI3OPAaOHQk2tfT90Fv7GhIHq/UlmLZ4k2p29Op3DeEMzxsqk7XBuoqzkyy5BdYkvQ//0BithiBX8AAAA="
   },
   "Metadata": {
    "aws:cdk:path": "GitHubOidcStack/CDKMetadata/Default"
   }
  }
 },
 "Outputs": {
  "GitHubCdkDeployRoleArn": {
   "Value": {
    "Fn::GetAtt": [
     "GitHubCdkDeployRole5F595E0B",
     "Arn"
    ]
   }
  }
 }
}